<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/driverRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
    <FrameLayout android:id="@+id/driverContainer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:id="@+id/driverNav" android:layout_width="match_parent" android:layout_height="72dp" android:background="@android:color/white" android:elevation="5dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/navDriverHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_home" android:contentDescription="Home" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textSize="10sp" /></LinearLayout>
        <LinearLayout android:id="@+id/navDriverTrips" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_route" android:contentDescription="Trips" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trips" android:textSize="10sp" /></LinearLayout>
        <LinearLayout android:id="@+id/navDriverHistory" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_history" android:contentDescription="History" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="History" android:textSize="10sp" /></LinearLayout>
        <LinearLayout android:id="@+id/navDriverProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_person" android:contentDescription="Profile" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profile" android:textSize="10sp" /></LinearLayout>
    </LinearLayout>
</LinearLayout>
